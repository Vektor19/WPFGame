<Application x:Class="Lab1_Game.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Lab1_Game"
             StartupUri="StartWindow.xaml">
    <Application.Resources>
        <LinearGradientBrush x:Key="GrayBlueGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFFFF29E" Offset="0" />
            <GradientStop Color="#FFE0C265" Offset="0.5" />
            <GradientStop Color="#FFC0AA3D" Offset="1" />
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Width" Value="90" />
            <Setter Property="Margin" Value="10" />
            
        </Style>
    </Application.Resources>
</Application>
