<Window x:Class="Lab1_Game.StartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab1_Game"
        mc:Ignorable="d"
        Title="StartWindow" Height="165" Width="336">
    <Grid Margin="0,0,0,-6">
        <Label Foreground="Black" Content="Enter Name" HorizontalAlignment="Center" Height="29" Margin="0,10,0,0" VerticalAlignment="Top" Width="84"/>
        <TextBox Name="PlayerName" HorizontalAlignment="Center" Height="39" TextWrapping="Wrap" VerticalAlignment="Top" Width="180" Margin="0,44,0,0"/>
        <Button Content="Play" HorizontalAlignment="Center" Height="43" Margin="0,88,0,0" VerticalAlignment="Top" Width="136" Click="Button_Click"/>

    </Grid>
</Window>
